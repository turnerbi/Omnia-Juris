# Example environment configuration for Omnia Juris

# Database connection string used by Prisma.  Replace the
# placeholder values with your PostgreSQL credentials when
# deploying to Railway, Supabase or other providers.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/omnia_juris"

# JWT secret used to sign access tokens.  Choose a strong
# random string before deploying.
JWT_SECRET="replace-with-your-secret-key"

# Port on which the API server listens
PORT=3000

# (Optional) Supabase storage configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="public-anon-key"
